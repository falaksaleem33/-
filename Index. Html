// Update Dashboard

function updateDashboard() {

    let total = loginRecords.length;

    let successful = loginRecords.filter(
        record => record.status === "Success"
    ).length;

    let suspicious = loginRecords.filter(
        record => record.status === "Suspicious"
    ).length;

    document.getElementById("total").textContent = total;

    document.getElementById("successful").textContent =
        successful;

    document.getElementById("suspicious").textContent =
        suspicious;
}


// Display Login Records

function displayRecords() {

    let search = document.getElementById("search")
        .value.toLowerCase();

    let filter = document.getElementById("filter").value;

    let table = document.getElementById("records");

    table.innerHTML = "";

    let filtered = loginRecords.filter(record => {

        let matchesSearch =
            record.user.toLowerCase().includes(search) ||
            record.location.toLowerCase().includes(search);

        let matchesFilter =
            filter === "All" || record.status === filter;

        return matchesSearch && matchesFilter;

    });

    filtered.forEach(record => {

        let row = document.createElement("tr");

        [
            record.user,
            record.location,
            record.device,
            record.time
        ].forEach(value => {

            let cell = document.createElement("td");

            cell.textContent = value;

            row.appendChild(cell);

        });

        let statusCell = document.createElement("td");

        statusCell.textContent = record.status;

        statusCell.className =
            record.status === "Success" ? "success" : "suspicious";

        row.appendChild(statusCell);

        table.appendChild(row);

    });

    // Show message if no records are found

    if (filtered.length === 0) {

        let row = document.createElement("tr");

        let cell = document.createElement("td");

        cell.colSpan = 5;

        cell.textContent = "No records found.";

        row.appendChild(cell);

        table.appendChild(row);

    }

}


// Display Suspicious Alerts

function displayAlerts() {

    let alertList = document.getElementById("alertList");

    alertList.innerHTML = "";

    let suspiciousRecords = loginRecords.filter(
        record => record.status === "Suspicious"
    );

    if (suspiciousRecords.length === 0) {

        alertList.textContent = "No suspicious demo events.";

        return;

    }

    suspiciousRecords.forEach(record => {

        let alert = document.createElement("div");

        alert.className = "alert";

        let message = document.createElement("p");

        message.textContent =
            "⚠ Suspicious Login: " + record.user +
            " | Location: " + record.location +
            " | Device: " + record.device +
            " | Time: " + record.time;

        alert.appendChild(message);

        alertList.appendChild(alert);

    });

}


// Simulate New Login Event

function simulateLogin() {

    let newRecord = {

        user: "Demo Visitor",

        location: "Unknown Location",

        device: "Unknown Browser",

        time: new Date().toLocaleTimeString(),

        status: "Suspicious"

    };

    loginRecords.unshift(newRecord);

    updateDashboard();

    displayRecords();

    displayAlerts();

    alert("New suspicious demo login event added!");

}


// Open Dashboard

function showDashboard() {

    document.getElementById("dashboard").scrollIntoView({

        behavior: "smooth"

    });

}


// Initial Page Rendering

